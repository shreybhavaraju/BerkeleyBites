# BerkeleyBites Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# AI/LLM Keys (required)
# ============================================

# Perplexity API Key (required for recommendations)
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ============================================
# Supabase Configuration (required for database)
# ============================================

# For local development with Supabase CLI:
# 1. Install: brew install supabase/tap/supabase
# 2. Start: supabase start
# 3. Get values: supabase status

# Local Supabase (default values work with 'supabase start')
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Set to false to fall back to CSV storage (no Supabase needed)
USE_SUPABASE=true

# ============================================
# Optional Keys
# ============================================

# LangSmith (optional - for tracing/observability)
# Get your key at: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=berkeleybites

# Context7 MCP API Key (optional - using Open-Meteo as fallback)
CONTEXT7_API_KEY=
